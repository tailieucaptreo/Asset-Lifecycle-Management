// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Device {
  id              Int      @id @default(autoincrement())
  name            String
  line            String
  station         String

  code            String?
  area            String?

  deviceId        String?     // 🔥 chống trùng

  status          String

  installDate     DateTime?
  lastMaintenance DateTime?

  lifespan        Int?
  expiryDate      DateTime?

  createdAt       DateTime @default(now())
  workOrders      WorkOrder[]
}

model WorkOrder {
  id        Int      @id @default(autoincrement())
  title     String
  status    String
  deviceId  Int
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id])
}

model SpareDevice {

  id               Int       @id @default(autoincrement())

  name             String

  deviceId         String?

  symbol           String?

  materialCode     String?

  initialQuantity  Int       @default(0)

  quantity         Int       @default(0)

  importQty        Int       @default(0)

  exportQty        Int       @default(0)

  unit             String?

  condition        String

  buyDate          DateTime?

  removedDate      DateTime?

  warehouse        String?

  cabinet          String?

  shelf            String?

  slot             String?

  image            String?

  note             String?

  createdAt        DateTime  @default(now())
}
