// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())

  username  String   @unique

  password  String

  role      String   @default("user")

  importSessions ImportSession[]

  createdAt DateTime @default(now())
}

model Device {

  id              Int      @id @default(autoincrement())

  name            String
  line            String
  station         String

  category        String?

  code            String?
  area            String?

  deviceId        String?

  status          String

  installDate     DateTime?
  lastMaintenance DateTime?

  lifespan        Int?
  expiryDate      DateTime?

  createdAt       DateTime @default(now())

  workOrders      WorkOrder[]

  @@unique([line, code])
}

model WorkOrder {
  id        Int      @id @default(autoincrement())
  title     String
  status    String
  deviceId  Int
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id])
}

model SpareDevice {

  id               Int       @id @default(autoincrement())

  name             String

  deviceId         String?

  symbol           String?

  materialCode     String?

  initialQuantity  Int       @default(0)

  quantity         Int       @default(0)

  importQty        Int       @default(0)

  exportQty        Int       @default(0)

  unit             String?

  condition        String

  buyDate          DateTime?

  removedDate      DateTime?

  warehouse        String?

  cabinet          String?

  shelf            String?

  slot             String?

  image            String?

  note             String?

  editedBy         String?

  createdAt        DateTime  @default(now())
}
model SpareHistory {

  id          Int      @id @default(autoincrement())

  action      String

  deviceName  String

  quantity    Int

  editedBy    String?

  note        String?

  createdAt   DateTime @default(now())
}

model VaconRecord {
  id                Int      @id @default(autoincrement())

  recordDate        DateTime?
  station           String?
  tandem            String?

  deviceName        String?
  serialNumber      String?
  application       String?

  powerUnitDate     String?

  faultHistory      String?   @db.Text
  operationHours    String?

  description       String?   @db.Text
  possibleCause     String?   @db.Text
  correctiveActions String?   @db.Text
  note              String?   @db.Text

  createdAt         DateTime @default(now())
}

model Drive {

  id            Int      @id @default(autoincrement())

  name          String

  deviceId      String?

  brand         String

  model         String

  serialNumber  String?

  firmware      String?

  ipAddress     String?

  power         String?

  voltage       String?

  current       String?

  line          String?

  station       String?

  location      String?

  status        String   @default("Running")

  image         String?

  note          String?

  installDate   DateTime?

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  faults        DriveFault[]
}

model DriveFault {

  id            Int @id @default(autoincrement())

  driveId       Int

  code          String

  title         String

  description   String?

  solution      String?

  repairedBy    String?

  note          String?

  createdAt     DateTime @default(now())

  drive Drive @relation(fields: [driveId], references: [id], onDelete: Cascade)
}

model AbbFaultRecord {

  id               Int      @id @default(autoincrement())

  typeCode         String?

  serialNumber     String?

  line             String?

  station          String?

  application      String?

  firmware         String?

  currentStatus    String?

  replaceReason    String?

  operationHours   Float?

  lastReplaceDate  DateTime?

  onTimeDay        Int?

  runningDay       Int?

  lastMaintenance  DateTime?

  maintenanceWork  String?   @db.Text

  note             String?   @db.Text

  createdAt        DateTime @default(now())

}

model VaconDevice {

  id            Int      @id @default(autoincrement())

  deviceName    String

  serialNumber  String   @unique

  station       String?

  tandem        String?

  application   String?

  createdAt     DateTime @default(now())

  histories     VaconHistory[]
}

model VaconHistory {

  id                  Int      @id @default(autoincrement())

  deviceId            Int

  device              VaconDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  recordDate          DateTime?

  operationHours      String?

  powerUnitDate       String?

  faultHistory        String?

  description         String?

  possibleCause       String?

  correctiveActions   String?

  note                String?

  createdAt           DateTime @default(now())

  @@index([deviceId])

  @@index([recordDate])
}

model ImportSession {

  id String @id @default(cuid())

  module String

  filename String?

  data Json

  total Int

  newCount Int

  updateCount Int

  skipCount Int

  userId Int?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  expiredAt DateTime

}

model Motor {

  id                Int       @id @default(autoincrement())

  // Thông tin thiết bị
  deviceId          String?
  name              String
  type              String

  quantity          Int?       // Số lượng

  brand             String
  model             String
  serial            String?

  // Thông số kỹ thuật
  power             String?
  voltage           String?
  current           String?
  frequency         String?
  rpm               String?
  efficiency        String?
  pole              String?
  bearingCode       String?

  // Vị trí
  line              String?
  station           String?
  location          String?
  warehouse         String?

  // Trạng thái
  status            String    @default("Running")

  // Thời gian
  installDate       DateTime?
  maintenanceDate   DateTime?
  replacementDate   DateTime?

  // Theo dõi thay thế
  oldMotor          String?   @db.Text     // Cũ
  newMotor          String?   @db.Text     // Mới

  // Nội dung bảo trì
  maintenanceContent String?  @db.Text

  // Vận hành
  runningHours      Int?

  // Khác
  image             String?
  note              String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  histories         MotorHistory[]
  maintenances      MotorMaintenance[]
  faults            MotorFault[]
  @@unique([deviceId, name, line, station, location])
}

model MotorHistory {

  id          Int      @id @default(autoincrement())

  motorId     Int?

  motor       Motor?   @relation(fields:[motorId], references:[id], onDelete:SetNull)

  action      String

  user        String?

  deviceId    String?

  name        String?

  note        String?

  changes     Json?

  createdAt   DateTime @default(now())
}

model MotorMaintenance {

  id            Int      @id @default(autoincrement())

  motorId       Int

  motor         Motor    @relation(fields:[motorId], references:[id], onDelete:Cascade)

  maintenanceDate DateTime

  type          String?

  technician    String?

  runningHours  Int?

  cost          Float?

  result        String?

  note          String?

  createdAt     DateTime @default(now())
}

model MotorFault {

  id          Int      @id @default(autoincrement())

  motorId     Int

  motor       Motor    @relation(fields:[motorId], references:[id], onDelete:Cascade)

  faultDate   DateTime @default(now())

  faultCode   String?

  title       String

  description String?

  solution    String?

  downtime    Int?

  status      String @default("Resolved")

  createdAt   DateTime @default(now())
}
